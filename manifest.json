{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.5",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "122",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png"
    },
    "default_title": "Video Companion",
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/hls/m3u8-interceptor-main.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "public/icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "__MSG_cmdTogglePip__"
    },
    "toggle-fullscreen": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "__MSG_cmdToggleFullscreen__"
    },
    "speed-up": {
      "suggested_key": {
        "default": "Alt+Shift+Period",
        "mac": "Alt+Shift+Period"
      },
      "description": "__MSG_cmdSpeedUp__"
    },
    "speed-down": {
      "suggested_key": {
        "default": "Alt+Shift+Comma",
        "mac": "Alt+Shift+Comma"
      },
      "description": "__MSG_cmdSpeedDown__"
    }
  }
}